# 本文件是 awdocker 独立起全套基础设施时的唯一取值来源（单一真相源）。

# 共享网络名（各片段统一引用，跨项目互联时须设成相同值）
INFRA_NETWORK=awdocker

# MySQL
MYSQL_IMAGE=mysql:9.7
MYSQL_ROOT_PASSWORD=awdocker_dev
MYSQL_DATABASE=awdocker
MYSQL_PORT=3306

# Redis
REDIS_IMAGE=redis:8.0
REDIS_PASSWORD=awdocker_dev
REDIS_PORT=6379

# PostgreSQL
POSTGRES_IMAGE=postgres:18
POSTGRES_USER=awdocker
POSTGRES_PASSWORD=awdocker_dev
POSTGRES_DATABASE=awdocker
POSTGRES_PORT=5432
