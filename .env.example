# MySQL
MYSQL_ROOT_PASSWORD=awdocker_dev
MYSQL_DATABASE=awdocker
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=awdocker_dev
REDIS_PORT=6379

# PostgreSQL（容器初始化用，须与 POSTGRES_URL 一致）
POSTGRES_USER=awdocker
POSTGRES_PASSWORD=awdocker_dev
POSTGRES_DATABASE=awdocker
POSTGRES_PORT=5432

# 统一数据源连接串（sqlx 使用，须与上面 POSTGRES_* 对应）
POSTGRES_URL=postgres://awdocker:awdocker_dev@localhost:5432/awdocker
